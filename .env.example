# ── Required in production ──
NODE_ENV=production
# 32-byte key for AES-256-GCM token encryption. Generate: npm run keygen  (NEVER change after accounts are connected)
APP_ENCRYPTION_KEY=
# Public HTTPS URL of this server (used for OAuth redirect URIs and Meta callbacks)
PUBLIC_BASE_URL=https://bot.example.com
PORT=3000
DATABASE_PATH=./data/niv-bot.db

# ── Meta: Instagram API with Instagram Login (recommended) ──
# Meta App Dashboard → Instagram → API setup with Instagram login → Instagram app ID / secret
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# ── Meta: Instagram API with Facebook Login (optional; enables Business Discovery: competitors + audience enrichment) ──
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ── Webhooks (real-time comment/DM auto-replies): any random string, pasted in Meta App Dashboard → Webhooks ──
META_WEBHOOK_VERIFY_TOKEN=

# ── Optional ──
META_GRAPH_VERSION=v23.0
# all = HTTP + automation engine (default) · web = HTTP only · worker = engine only
APP_ROLE=all
WORKER_CONCURRENCY=3
# Set to false after creating your organization to close public sign-up
ALLOW_REGISTRATION=true
LOG_LEVEL=info
