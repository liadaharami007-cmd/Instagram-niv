{
  "name": "instagram-niv-bot",
  "version": "1.0.0",
  "description": "Instagram Niv Bot — multi-account Instagram growth management on the official Meta APIs",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.ts",
    "dev": "node --disable-warning=ExperimentalWarning --watch src/server.ts",
    "test": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "keygen": "node -e \"console.log(require('crypto').randomBytes(32).toString('base64'))\"",
    "test:e2e": "node --disable-warning=ExperimentalWarning test/e2e/ui.e2e.ts",
    "demo:video": "node --disable-warning=ExperimentalWarning scripts/record-demo.ts",
    "verify:meta": "node --disable-warning=ExperimentalWarning scripts/verify-meta.ts",
    "bench": "node --disable-warning=ExperimentalWarning scripts/bench.ts"
  },
  "dependencies": {
    "@fastify/static": "^8.3.0",
    "fastify": "^5.12.8",
    "pino": "^9.14.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
}
